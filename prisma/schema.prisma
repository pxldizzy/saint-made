generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Site accounts. The password is stored as a scrypt hash (see lib/password.ts).
model User {
  id           String    @id @default(cuid())
  name         String
  /// Either e-mail or phone identifies the account; at least one is required.
  email        String?   @unique
  phone        String?   @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  addresses    Address[]
  orders       Order[]
}

/// Saved delivery addresses; the default one prefills checkout.
model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("")
  city      String
  street    String
  apartment String   @default("")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Two levels: root categories are the header sections (МУЖСКОЕ / ЖЕНСКОЕ /
/// ОБУВЬ), their children are the catalog tabs (ФУТБОЛКИ, БРЮКИ, …).
model Category {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  sortOrder Int        @default(0)
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Category[] @relation("CategoryTree")
  products  Product[]

  @@index([parentId])
}

/// Prices are stored in minor units (копейки) to avoid float rounding.
model Product {
  id          String         @id @default(cuid())
  slug        String         @unique
  title       String
  description String         @default("")
  price       Int
  oldPrice    Int?
  categoryId  String?
  category    Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images      ProductImage[]
  variants    Variant[]
  orderItems  OrderItem[]
  isHidden    Boolean        @default(false)
  isNew       Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([categoryId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String  @default("")
  sortOrder Int     @default(0)

  @@index([productId])
}

/// One row per size+color combination; `stock` is the remaining quantity.
model Variant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  color     String  @default("")
  colorHex  String  @default("")
  stock     Int     @default(0)

  @@unique([productId, size, color])
  @@index([productId])
}

/// status: new | processing | shipped | delivered | cancelled
model Order {
  id        Int         @id @default(autoincrement())
  /// Set when the buyer was signed in; guest orders are matched by e-mail.
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  phone     String
  email     String      @default("")
  address   String      @default("")
  comment   String      @default("")
  status    String      @default("new")
  total     Int
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  items     OrderItem[]

  @@index([status])
  @@index([createdAt])
  @@index([userId])
}

/// Title/price are snapshotted so an order stays readable if the product changes.
model OrderItem {
  id        String   @id @default(cuid())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  title     String
  size      String
  color     String   @default("")
  price     Int
  qty       Int

  @@index([orderId])
  @@index([productId])
}
